# Jarvis .env configuration
#
# Démarrage rapide :
# 1) Copiez ce fichier en `.env` (pour lancer depuis ce repo), OU dans `~/.openclaw/.env` (pour les daemons).
# 2) Remplissez uniquement les valeurs que vous utilisez.
# 3) Gardez vos secrets hors de git.
#
# Précédence des variables d'environnement (haute → basse) :
# process env, ./.env, ~/.openclaw/.env, puis bloc `env` dans openclaw.json.

# -----------------------------------------------------------------------------
# Gateway auth + chemins
# -----------------------------------------------------------------------------
# Recommandé si le gateway écoute au-delà du loopback.
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Générateur : openssl rand -hex 32

# Mode d'auth alternatif (utilisez token OU password).
# OPENCLAW_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Overrides de chemins optionnels (valeurs par défaut montrées pour référence).
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_HOME=~

# -----------------------------------------------------------------------------
# Clés API des fournisseurs de modèles (configurez au moins une)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# GOOGLE_API_KEY=...

# -----------------------------------------------------------------------------
# Canaux de messagerie (configurez seulement ceux que vous activez)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# -----------------------------------------------------------------------------
# 🏠 DOMOTIQUE — Configuration maison connectée
# -----------------------------------------------------------------------------

# Home Assistant
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=votre_token_longue_durée

# MQTT (Zigbee2MQTT, Tasmota, ESPHome, etc.)
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_USERNAME=jarvis
# MQTT_PASSWORD=votre_mot_de_passe

# Tuya / Smart Life
# TUYA_ACCESS_ID=votre_access_id
# TUYA_ACCESS_KEY=votre_access_key
# TUYA_REGION=eu  # eu, us, cn, in

# Philips Hue (configuré automatiquement par le skill openhue)
# Appuyez sur le bouton du pont Hue lors de la première connexion

# Sonos (découverte automatique sur le réseau local)
# SPOTIFY_CLIENT_ID=...  # Optionnel pour recherche Spotify via Sonos
# SPOTIFY_CLIENT_SECRET=...

# -----------------------------------------------------------------------------
# 🎙️ MODULE VOCAL — Micros à domicile + Mistral STT
# -----------------------------------------------------------------------------
#
# Architecture : Micro → sox (VAD) → Mistral STT → Jarvis → TTS → Haut-parleur
# Wake word par défaut : "Jarvis"
#
# Prérequis : sox installé (brew install sox / apt install sox)
#             + MISTRAL_API_KEY ci-dessous

# Clé API Mistral (pour la transcription vocale)
# Obtenez votre clé sur https://console.mistral.ai
# MISTRAL_API_KEY=votre_clé_api_mistral

# Personnalisation optionnelle du STT
# MISTRAL_STT_MODEL=mistral-stt        # Modèle de transcription
# MISTRAL_STT_LANGUAGE=fr              # Langue principale
# MISTRAL_API_BASE_URL=https://api.mistral.ai/v1  # Endpoint API

# Identifiant de l'utilisateur propriétaire (pour les notifications autonomes)
# = votre ID Telegram, Discord ID, etc.
# JARVIS_OWNER_ID=123456789
# JARVIS_NOTIFICATION_CHANNEL=telegram  # Canal de livraison

# TTS système pour les réponses vocales
# macOS : Thomas (français), Daniel (anglais)
# Linux : fr+m3, en+m3 (espeak-ng)
# JARVIS_TTS_VOICE=Thomas
# JARVIS_TTS_LANG=fr

# Device microphone (laisser vide = micro système par défaut)
# Linux ALSA : hw:1,0 | hw:2,0
# macOS AVFoundation : :0 | :1
# JARVIS_MIC_DEVICE=

# -----------------------------------------------------------------------------
# 🛠️ Outils + voix/média (optionnel)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...     # TTS voix naturelle (recommandé pour voix Jarvis)
# XI_API_KEY=...             # alias pour ElevenLabs
# DEEPGRAM_API_KEY=...       # Alternative STT

# -----------------------------------------------------------------------------
# 🎤 ELEVENLABS TTS — Voix naturelle pour Jarvis
# -----------------------------------------------------------------------------
# Si défini, le module vocal utilisera ElevenLabs pour les réponses (priorité sur TTS système).
# Obtenez une clé sur https://elevenlabs.io
#
# ELEVENLABS_API_KEY=sk_...   # Clé ElevenLabs
# ELEVENLABS_VOICE_ID=...     # ID de voix (défaut: pNInz6obpgDQGcFmaJgB = "Adam")
# ELEVENLABS_MODEL_ID=...     # Modèle (défaut: eleven_multilingual_v2)
#
# Voix françaises recommandées :
#   - pNInz6obpgDQGcFmaJgB  → Adam (neutre, multilingue)
#   - N2lVS1w4EtoT3dr4eOWO  → Callum (grave, dramatique)
#   - yoZ06aMxZJJ28mfd3POQ  → Sam (naturel)
#   - Répertoire complet : https://elevenlabs.io/voice-library
#
# Prérequis Linux pour la lecture audio : sudo apt install mpg123
# (afplay inclus nativement sur macOS)
